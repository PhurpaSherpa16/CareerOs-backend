generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  clerkUserId String      @unique
  resumes     Resume[]
  jobs        Job[]
  resumeJobs  ResumeJob[]
  analyses    Analysis[]
}

model Resume {
  id             String      @id @default(uuid())
  userId         String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  fileName       String?
  fileUrl        String?
  rawText        String?
  structuredText Json?
  title          String
  resumeJobs     ResumeJob[]
  resumeContentHash String?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id             String      @id @default(uuid())
  userId         String
  title          String
  description    String
  structuredText Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  company        String?
  jobUrl         String?
  jobContentHash String?
  resumeJobs     ResumeJob[]
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeJob {
  id        String     @id @default(uuid())
  userId    String
  resumeId  String
  jobId     String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume    Resume     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job       Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  analyses  Analysis[]

  @@unique([resumeId, jobId])
}

model Analysis {
  id          String @id @default(uuid())
  userId      String
  resumeJobId String

  atsScore        Int?
  atsScoreReason  String?
  fit             Json?
  matchMetrics    Json?
  matchedSkills   Json?
  missingSkills   Json?
  matchedKeywords Json?
  missingKeywords Json?
  insight         Json?
  summary         String?
  strucutred      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeJob ResumeJob @relation(fields: [resumeJobId], references: [id])
}

model Guest {
  id           String         @id @default(uuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  count        Int            @default(0)
  tempAnalysis TempAnalysis[]
}

model TempAnalysis {
  id                   String   @id @default(uuid())
  guestId              String
  resumeRawText        String?
  resumeStructuredText Json?
  jobRawText           String?
  jobStructuredText    Json?
  atsScore             Int?
  matchedSkills        Json?
  missingSkills        Json?
  matchedKeywords      Json?
  insights             Json?
  result               Json?
  resumeContentHash    String?
  jobContentHash       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  atsScoreReason       String?
  fit                  Json?
  jobMatch             Json?
  matchMetrics         Json?
  missingKeywords      Json?
  experienceMatch      Json?
  guest                Guest    @relation(fields: [guestId], references: [id])
}
